{
  "name": "freshcart-mern-ecommerce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "storefront",
    "admin",
    "packages/design-system"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -k -n server,storefront,admin \"npm run dev -w server\" \"npm run dev -w storefront\" \"npm run dev -w admin\"",
    "dev:server": "npm run dev -w server",
    "dev:storefront": "npm run dev -w storefront",
    "dev:admin": "npm run dev -w admin",
    "build": "npm run build -w storefront && npm run build -w admin",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test -w server",
    "validate": "npm run lint && npm test && npm run build && npm run test:browser",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "test:browser": "playwright test",
    "seed:admin": "npm run seed:admin -w server"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0"
  }
}
